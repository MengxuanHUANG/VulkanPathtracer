#version 450

#extension GL_EXT_mesh_shader : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require

struct Task
{
	int task_id;
	vec3 color;
};

struct MeshletDescription
{
	vec4 boundingSphere;
	uint modelId;
	uint vertexCount;
	uint primCount;
	uint vertexBegin;
	uint primBegin;
};

struct ModelMatrix
{
	mat4 model;
	mat4 invModel;
};

taskPayloadSharedEXT Task OUT;

layout(set = 0, binding = 0) uniform CameraUBO {
	uvec4 meshletCount;
	vec4 pos;
    mat4 viewProjMat;
	vec4 planes[6];
} u_CamUBO;

layout(set = 1, binding = 0) buffer MeshletInfos {
    MeshletDescription meshlets[];
};

layout(set = 1, binding = 1) buffer ModelMatries {
    ModelMatrix modelMatrix[];
};

// A simple hash function
float hash(int n) {
    float a = float(n);
    return fract(sin(a) * 43758.5453);
}

// Generate a random color from an integer
vec3 randomColor(int seed) {
    // Use the hash function to generate random values for each color channel
    float r = hash(seed);
    float g = hash(seed + 1);
    float b = hash(seed + 2);

    return vec3(r, g, b);
}

shared uint outPutMeshletCount;

layout (local_size_x = 32) in;
void main()
{
	uint local_id = gl_LocalInvocationID.x;//(gl_LocalInvocationID.x + 31) % 32;

	if (local_id == 0) {
        outPutMeshletCount = 0;
    }
	// Synchronize to ensure 'outPutMeshletCount' is zero before any thread proceeds
    barrier();
	memoryBarrierShared();


	if(gl_GlobalInvocationID.x >= u_CamUBO.meshletCount.x){
		return;
	}

	atomicAdd(outPutMeshletCount, 1);
	barrier();
    memoryBarrierShared();

	if (local_id == 0 && outPutMeshletCount > 0) 
	{
		OUT.task_id = int(gl_WorkGroupID.x * 32);
		OUT.color = randomColor(OUT.task_id);
		EmitMeshTasksEXT(outPutMeshletCount, 1, 1);// use gl_WorkGroupID to index in mesh shader
	}
}
